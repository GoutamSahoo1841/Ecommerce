{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "MERN eCommerce application",
  "main": "server.js",
  "scripts": {
    "start": "npm start --prefix backend",
    "server": "npm run dev --prefix backend",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "npm run data:import --prefix backend",
    "data:destroy": "npm run data:destroy --prefix backend",
    "build": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
